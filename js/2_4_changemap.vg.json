            "baseline": "middle",
            "dx": 12,
            "dy": -68.5,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#222",
            "lineHeight": 13,
            "text": [
              "Metro North West line",
              "(opened May 2019)"
            ],
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        }
      ]
    }
  ],
  "params": [
    {
      "name": "statusShow",
      "value": "All stations",
      "bind": {
        "input": "select",
        "options": [
          "All stations",
          "Under 60%",
          "60–90%",
          "90–110%",
          "Over 110%",
          "New station",
          "Closed for upgrade"
        ],
        "labels": [
          "All stations",
          "Under 60%",
          "60–90%",
          "90–110%",
          "Over 110%",
          "New Metro",
          "Closed"
        ],
        "name": "Show ",
        "element": "#filter_2_4"
      }
    },
    {
      "name": "centre",
      "value": [
        151.03,
        -33.85
      ]
    },
    {
      "name": "zoom",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 6.5,
        "step": 0.01,
        "name": "Zoom ",
        "element": "#zoom_2_4"
      }
    }
  ]
}