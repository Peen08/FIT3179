            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "dx": 12,
            "dy": -68.5,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "white",
            "lineHeight": 13,
            "text": [
              "Metro North West line",
              "(opened May 2019)"
            ],
            "opacity": 1,
            "stroke": "white",
            "strokeWidth": 3,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
