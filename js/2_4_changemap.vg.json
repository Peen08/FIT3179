{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "centre"
    },
    "scale": {
      "expr": "zoom * 32600"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/syd_land.topojson",
        "format": {
          "type": "topojson",
          "feature": "syd_land"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1F1EC",
        "stroke": "#DDDDDD",
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/syd_lines.topojson",
        "format": {
          "type": "topojson",
          "feature": "syd_lines"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#C8C8C8",
        "strokeWidth": 1,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/syd_stations.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "y2019": "number",
            "y2021": "number",
            "y2022": "number",
            "y2023": "number",
            "y2025": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.y2025 / datum.y2019 * 100",
          "as": "pct"
        },
        {
          "calculate": "isFinite(datum.pct) ? format(datum.pct, '.0f') + '%' : 'New station (no 2019 trips)'",
          "as": "pct_tip"
        },
        {
          "calculate": "datum.y2019 == 0 ? 'New station' : (datum.y2025 < datum.y2019 * 0.02 ? 'Closed for upgrade' : (datum.pct < 60 ? 'Under 60%' : (datum.pct < 90 ? '60–90%' : (datum.pct < 110 ? '90–110%' : 'Over 110%'))))",
          "as": "status"
        },
        {
          "calculate": "max(datum.y2025, datum.y2019)",
          "as": "size_val"
        },
        {
          "filter": "statusShow == 'All stations' || datum.status == statusShow"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.85,
            "stroke": "white",
            "strokeWidth": 0.5,
            "clip": true
          },
          "encoding": {
            "size": {
              "field": "size_val",
              "type": "quantitative",
              "legend": null,
              "scale": {
                "type": "sqrt",
                "range": [
                  6,
                  700
                ]
              }
            },
            "color": {
              "field": "status",
              "type": "nominal",
              "title": "2025 compared with 2019",
              "scale": {
                "domain": [
                  "Under 60%",
                  "60–90%",
                  "90–110%",
                  "Over 110%",
                  "New station",
                  "Closed for upgrade"
                ],
                "range": [
                  "#B3471A",
                  "#F0B58A",
                  "#D5D5D0",
                  "#2166AC",
                  "#7E3FB0",
                  "#000000"
                ]
              },
              "legend": {
                "title": "Station trips in 2025 as a percentage of 2019",
                "orient": "bottom",
                "direction": "horizontal",
                "columns": 4,
                "symbolType": "circle",
                "labelExpr": "datum.label == 'New station' ? 'New Metro station' : datum.label == 'Closed for upgrade' ? 'Closed for conversion' : datum.label"
              }
            },
            "tooltip": [
              {
                "field": "station",
                "title": "Station"
              },
              {
                "field": "y2019",
                "format": ",",
                "title": "Trips 2019"
              },
              {
                "field": "y2025",
                "format": ",",
                "title": "Trips 2025"
              },
              {
                "field": "pct_tip",
                "title": "Percentage of 2019"
              }
            ],
            "opacity": {
              "value": 0.85
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.station == 'Lakemba'"
            }
          ],
          "mark": {
            "type": "point",
            "shape": "M 46.6 39.1 L 10.1 8.5 M 5.7 4.7 L 7.9 11.0 L 12.3 5.9 Z",
            "size": 4,
            "filled": true,
            "color": "#555",
            "stroke": "#555",
            "strokeWidth": 1.3,
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.station == 'Lakemba'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 48.9,
            "dy": 41.1,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "white",
            "lineHeight": 13,
            "text": [
              "Bankstown line",
              "closed for",
              "Metro upgrade"
            ],
            "opacity": 1,
            "stroke": "white",
            "strokeWidth": 3,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.station == 'Lakemba'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 48.9,
            "dy": 41.1,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#222",
            "lineHeight": 13,
            "text": [
              "Bankstown line",
              "closed for",
              "Metro upgrade"
            ],
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.station == 'North Sydney'"
            }
          ],
          "mark": {
            "type": "point",
            "shape": "M 45.1 0.2 L 16.7 0.1 M 10.9 0.0 L 16.7 3.4 L 16.7 -3.3 Z",
            "size": 4,
            "filled": true,
            "color": "#555",
            "stroke": "#555",
            "strokeWidth": 1.3,
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.station == 'North Sydney'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 49.1,
            "dy": -12.8,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "white",
            "lineHeight": 13,
            "text": [
              "North Sydney:",
              "riders moved to",
              "Victoria Cross"
            ],
            "opacity": 1,
            "stroke": "white",
            "strokeWidth": 3,
            "strokeJoin": "round"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.station == 'North Sydney'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 49.1,
            "dy": -12.8,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#222",
            "lineHeight": 13,
            "text": [
              "North Sydney:",
              "riders moved to",
              "Victoria Cross"
            ],
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.station == 'Castle Hill'"
            }
          ],
          "mark": {
            "type": "point",
            "shape": "M 12.0 -46.0 L 3.6 -13.6 M 2.1 -8.0 L 6.8 -12.8 L 0.3 -14.5 Z",
            "size": 4,
            "filled": true,
            "color": "#555",
            "stroke": "#555",
            "strokeWidth": 1.3,
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
