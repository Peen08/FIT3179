{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/melb_stations.csv",
    "format": {
      "type": "csv",
      "parse": {
        "lat": "number",
        "lon": "number",
        "entries_2425": "number",
        "pre_am": "number",
        "am_peak": "number",
        "interpeak": "number",
        "pm_peak": "number",
        "pm_late": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "entries_2425",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 20"
    },
    {
      "calculate": "datum.pre_am + datum.am_peak + datum.interpeak + datum.pm_peak + datum.pm_late",
      "as": "day_total"
    },
    {
      "fold": [
        "pre_am",
        "am_peak",
        "interpeak",
        "pm_peak",
        "pm_late"
      ],
      "as": [
        "band_key",
        "entries"
      ]
    },
    {
      "calculate": "{'pre_am':'Early','am_peak':'Morning peak','interpeak':'Midday','pm_peak':'Evening peak','pm_late':'Late evening'}[datum.band_key]",
      "as": "band"
    },
    {
      "calculate": "datum.entries / datum.day_total * 100",
      "as": "share"
    },
    {
      "calculate": "format(datum.share, '.0f') + '%'",
      "as": "share_tip"
    }
  ],
  "encoding": {
    "x": {
      "field": "band",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Early",
        "Morning peak",
        "Midday",
        "Evening peak",
        "Late evening"
      ],
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "labelExpr": "split(datum.label, ' ')",
        "labelLineHeight": 13,
        "labelPadding": 18
      }
    },
    "y": {
      "field": "station",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "entries_2425",
        "order": "descending"
      },
      "axis": {
        "labelFontWeight": {
          "expr": "indexof(['Flinders Street','Southern Cross','Melbourne Central','Parliament','Flagstaff','Craigieburn'], datum.value) >= 0 ? 'bold' : 'normal'"
        },
        "labelColor": {
          "expr": "indexof(['Flinders Street','Southern Cross','Melbourne Central','Parliament','Flagstaff','Craigieburn'], datum.value) >= 0 ? '#1F3B5C' : '#444'"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "share",
          "type": "quantitative",
          "title": "Share of day (%)",
          "scale": {
            "domain": [
              0,
              35,
              70
            ],
            "range": [
              "#FCE9F2",
              "#E0619E",
              "#8A1453"
            ],
            "interpolate": "lab"
          },
          "legend": {
            "values": [
              0,
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ],
            "orient": "right",
            "direction": "vertical",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "station"
          },
          {
            "field": "band",
            "title": "Time band"
          },
          {
            "field": "share_tip",
            "title": "Percentage of the day's entries"
          }
        ],
        "opacity": {
          "condition": {
            "param": "rowHover",
            "value": 1
          },
          "value": 0.25
        }
      },
      "params": [
        {
          "name": "rowHover",
          "select": {
            "type": "point",
            "fields": [
              "station"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.share >= 40"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "white"
      },
      "encoding": {
        "text": {
          "field": "share",
          "format": ".0f"
        },
        "opacity": {
          "condition": {
            "param": "rowHover",
            "value": 1
          },
          "value": 0.25
        }
      }
    },
    {
      "transform": [
        {
          "filter": "indexof(['Flinders Street','Southern Cross','Melbourne Central','Parliament','Flagstaff'], datum.station) >= 0 && datum.band == 'Evening peak'"
        }
      ],
      "mark": {
        "type": "rect",
        "filled": false,
        "stroke": "#1F3B5C",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "band",
          "type": "ordinal",
          "sort": [
            "Early",
            "Morning peak",
            "Midday",
            "Evening peak",
            "Late evening"
          ]
        },
        "y": {
          "field": "station",
          "type": "nominal",
          "sort": {
            "field": "entries_2425",
            "order": "descending"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.station == 'Craigieburn' && datum.band == 'Morning peak'"
        }
      ],
      "mark": {
        "type": "rect",
        "filled": false,
        "stroke": "#1F3B5C",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "band",
          "type": "ordinal",
          "sort": [
            "Early",
            "Morning peak",
            "Midday",
            "Evening peak",
            "Late evening"
          ]
        },
        "y": {
          "field": "station",
          "type": "nominal",
          "sort": {
            "field": "entries_2425",
            "order": "descending"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.station == 'Flinders Street' && datum.band == 'Early'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#EEF3F9",
        "stroke": "#C6D5E6",
        "strokeWidth": 1,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 12"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 146"
          }
        },
        "y": {
          "value": 232
        },
        "y2": {
          "value": 304
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.station == 'Flinders Street' && datum.band == 'Early'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 14,
        "color": "#1F3B5C",
        "text": [
          "City-centre stations:"
        ],
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 20"
          }
        },
        "y": {
          "value": 240
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.station == 'Flinders Street' && datum.band == 'Early'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 14,
        "color": "#1F3B5C",
        "text": [
          "Flinders Street, Southern",
          "Cross, Melbourne Central,",
          "Parliament, Flagstaff"
        ]
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 20"
          }
        },
        "y": {
          "value": 254
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.station == 'Flinders Street' && datum.band == 'Early'"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#EEF3F9",
        "stroke": "#C6D5E6",
        "strokeWidth": 1,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 12"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 146"
          }
        },
        "y": {
          "value": 314
        },
        "y2": {
          "value": 374
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.station == 'Flinders Street' && datum.band == 'Early'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 14,
        "color": "#1F3B5C",
        "text": [
          "Suburban station:"
        ],
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 20"
          }
        },
        "y": {
          "value": 322
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.station == 'Flinders Street' && datum.band == 'Early'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 14,
        "color": "#1F3B5C",
        "text": [
          "Craigieburn: most entries",
          "in the morning peak"
        ]
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 20"
          }
        },
        "y": {
          "value": 336
        }
      }
    }
  ]
}