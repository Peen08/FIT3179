{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/bitre_city_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "train": "number",
        "light_rail": "number",
        "bus": "number",
        "ferry": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.train + datum.light_rail + datum.bus + datum.ferry",
      "as": "total"
    },
    {
      "calculate": "datum.year == 2019 ? datum.total : null",
      "as": "b"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "b",
          "as": "base"
        }
      ],
      "groupby": [
        "city"
      ]
    },
    {
      "calculate": "datum.total / datum.base * 100",
      "as": "index"
    },
    {
      "calculate": "format(datum.index, '.0f') + '%'",
      "as": "index_tip"
    },
    {
      "calculate": "datum.year == 2025 ? datum.index : null",
      "as": "l"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "l",
          "as": "latest"
        }
      ],
      "groupby": [
        "city"
      ]
    },
    {
      "calculate": "round(datum.latest) >= 100 ? 'Recovered (100% or more)' : 'Still short (under 100%)'",
      "as": "status"
    },
    {
      "calculate": "datum.city",
      "as": "label"
    },
    {
      "calculate": "datum.city == 'Perth' ? 'Highest recovery' : (datum.city == 'Brisbane' || datum.city == 'Canberra') ? 'Back to normal' : datum.city == 'Melbourne' ? 'Furthest behind' : ''",
      "as": "note"
    },
    {
      "lookup": "city",
      "from": {
        "data": {
          "values": [
            {
              "city": "Perth",
              "fyr": 2025,
              "ftext": "Record high: 105%",
              "fpos": "above"
            },
            {
              "city": "Brisbane",
              "fyr": 2025,
              "ftext": "Back to 100%",
              "fpos": "above"
            },
            {
              "city": "Canberra",
              "fyr": 2025,
              "ftext": "Back to 100%",
              "fpos": "above"
            },
            {
              "city": "Adelaide",
              "fyr": 2025,
              "ftext": [
                "Still short:",
                "91%"
              ],
              "fpos": "below-deep"
            },
            {
              "city": "Sydney",
              "fyr": 2022,
              "ftext": "Low: 43%",
              "fpos": "below"
            },
            {
              "city": "Darwin",
              "fyr": 2021,
              "ftext": "Smallest fall: 79%",
              "fpos": "below"
            },
            {
              "city": "Hobart",
              "fyr": 2024,
              "ftext": "Lowest in 2023–2024: 81%",
              "fpos": "below-left"
            },
            {
              "city": "Melbourne",
              "fyr": 2021,
              "ftext": "Deepest fall: 35%",
              "fpos": "below"
            }
          ]
        },
        "key": "city",
        "fields": [
          "fyr",
          "ftext",
          "fpos"
        ]
      }
    }
  ],
  "facet": {
    "field": "city",
    "type": "nominal",
    "header": {
      "title": null,
      "labelExpr": "''",
      "labelFontSize": 0,
      "labelPadding": 0
    },
    "sort": {
      "field": "latest",
      "op": "max",
      "order": "descending"
    }
  },
  "columns": 4,
