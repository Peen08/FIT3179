{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/syd_stations.csv",
    "format": {
      "type": "csv",
      "parse": {
        "lat": "number",
        "lon": "number",
        "y2019": "number",
        "y2021": "number",
        "y2022": "number",
        "y2023": "number",
        "y2025": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "y2019",
        "y2021",
        "y2022",
        "y2023",
        "y2025"
      ],
      "as": [
        "year_key",
        "trips"
      ]
    },
    {
      "calculate": "toNumber(substring(datum.year_key, 1))",
      "as": "year"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "trips",
          "order": "descending"
        }
      ],
      "groupby": [
        "year"
      ]
    },
    {
      "filter": "datum.rank <= 10"
    },
    {
      "calculate": "indexof(['Central','Town Hall','Martin Place','Circular Quay'], datum.station) >= 0 ? datum.station : 'Other'",
      "as": "grp"
    },
    {
      "calculate": "indexof([2019, 2021, 2022, 2023, 2025], datum.year)",
      "as": "yi"
    },
    {
      "window": [
        {
          "op": "lag",
          "field": "yi",
          "as": "prev_yi"
        }
      ],
      "sort": [
        {
          "field": "yi"
        }
      ],
      "groupby": [
        "station"
      ]
    },
    {
      "calculate": "isValid(datum.prev_yi) && datum.yi - datum.prev_yi > 1 ? 1 : 0",
      "as": "brk"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "brk",
          "as": "run"
        }
      ],
      "sort": [
        {
          "field": "yi"
        }
      ],
      "groupby": [
        "station"
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.station + '#' + datum.run",
      "as": "seg"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "domain": true,
        "ticks": true,
        "titlePadding": 8
      }
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "title": "Rank"
    },
    "color": {
      "field": "grp",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Central",
          "Town Hall",
          "Martin Place",
          "Circular Quay",
          "Other"
        ],
        "range": [
          "#8C5A2B",
          "#E377C2",
          "#B08D00",
          "#17BECF",
          "#C8C8C8"
        ]
      }
    },
    "opacity": {
      "condition": {
        "param": "hover",
        "value": 1
      },
      "value": 0.25
    },
    "detail": {
      "field": "station"
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "station"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 10,
        "opacity": 0
      },
      "encoding": {
        "opacity": {
          "value": 0
        },
        "detail": {
          "field": "seg"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!(datum.grp != 'Other')"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "seg"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.grp != 'Other'"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3.5
      },
      "encoding": {
        "detail": {
          "field": "seg"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 1
      },
      "encoding": {
        "size": {
          "condition": {
            "test": "datum.grp != 'Other'",
            "value": 80
          },
          "value": 40
        },
        "tooltip": [
          {
            "field": "station"
          },
          {
            "field": "year"
          },
          {
            "field": "rank"
          },
          {
            "field": "trips",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": {
          "expr": "datum.grp != 'Other' ? 'bold' : 'normal'"
        }
      },
      "encoding": {
        "text": {
          "field": "station"
        },
        "color": {
          "condition": {
            "test": "datum.grp != 'Other'",
            "field": "grp",
            "type": "nominal",
            "scale": {
              "domain": [
                "Central",
                "Town Hall",
                "Martin Place",
                "Circular Quay",
                "Other"
              ],
              "range": [
                "#8C5A2B",
                "#E377C2",
                "#B08D00",
                "#17BECF",
                "#C8C8C8"
              ]
            }
          },
          "value": "#888888"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025 && datum.station == 'Martin Place'"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "M -20 -18 L -8.8 -7.9 M -4.4 -4.0 L -6.5 -10.4 L -11.0 -5.4 Z",
        "size": 4,
        "filled": true,
        "color": "#555",
        "stroke": "#555",
        "strokeWidth": 1.3,
        "opacity": 1
      },
      "encoding": {
        "size": {
          "value": 4
        },
        "color": {
          "value": "#555"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025 && datum.station == 'Martin Place'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -22,
        "dy": -20,
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#555",
        "text": "Metro opened 2024",
        "baseline": "bottom"
      }
    }
  ]
}