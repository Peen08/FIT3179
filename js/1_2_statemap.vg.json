{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "params": [
    {
      "name": "fy",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2016,
        "max": 2025,
        "step": 1,
        "name": "Financial year ending June: "
      }
    }
  ],
  "hconcat": [
    {
      "width": 460,
      "height": 360,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -132,
          0
        ],
        "center": [
          0,
          -27
        ],
        "scale": 602.61,
        "translate": [
          218.95,
          178.69
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/aus_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "aus_states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#E6E6E0",
            "stroke": "white",
            "strokeWidth": 1
          }
        },
        {
          "data": {
            "url": "data/bitre_city_year.csv",
            "format": {
              "type": "csv",
              "parse": {
                "train": "number",
                "light_rail": "number",
                "bus": "number",
                "ferry": "number",
                "year": "number"
              }
            }
          },
          "transform": [
            {
              "calculate": "datum.train + datum.light_rail + datum.bus + datum.ferry",
              "as": "total"
            },
            {
              "calculate": "datum.year == 2019 ? datum.total : null",
              "as": "b"
            },
            {
              "joinaggregate": [
                {
                  "op": "max",
                  "field": "b",
                  "as": "base"
                }
              ],
              "groupby": [
                "city"
              ]
            },
            {
              "calculate": "datum.total / datum.base * 100",
              "as": "index"
            },
            {
              "calculate": "format(datum.index, '.0f') + '%'",
              "as": "pct_tip"
            },
            {
              "filter": "datum.year == fy"
            },
            {
              "lookup": "city",
              "from": {
                "data": {
                  "values": [
                    {
                      "city": "Sydney",
                      "lat": -33.87,
                      "lon": 151.21,
                      "side": "E",
                      "kx1": 0.11385,
                      "kx2": 0.01725,
                      "ky1": 0.01434,
                      "ky2": -0.09341,
                      "sy": 0
                    },
                    {
                      "city": "Melbourne",
                      "lat": -37.81,
                      "lon": 144.96,
                      "side": "W",
                      "kx1": 0.119,
                      "kx2": 0.01211,
                      "ky1": 0.00986,
                      "ky2": -0.09506,
                      "sy": -34.4
                    },
                    {
                      "city": "Brisbane",
                      "lat": -27.47,
                      "lon": 153.03,
                      "side": "W",
                      "kx1": 0.10703,
                      "kx2": 0.01778,
                      "ky1": 0.01557,
                      "ky2": -0.09261,
                      "sy": 64.6
                    },
                    {
                      "city": "Perth",
                      "lat": -31.95,
                      "lon": 115.86,
                      "side": "E",
                      "kx1": 0.11217,
                      "kx2": -0.01424,
                      "ky1": -0.01168,
                      "ky2": -0.09346,
                      "sy": 23.9
                    },
                    {
                      "city": "Adelaide",
                      "lat": -34.93,
                      "lon": 138.6,
                      "side": "W",
                      "kx1": 0.11616,
                      "kx2": 0.00601,
                      "ky1": 0.00508,
                      "ky2": -0.0946,
                      "sy": -0.1
                    },
                    {
                      "city": "Canberra",
                      "lat": -35.28,
                      "lon": 149.13,
                      "side": "S",
                      "kx1": 0.11566,
                      "kx2": 0.0156,
                      "ky1": 0.01286,
                      "ky2": -0.09394,
                      "sy": -12.2
                    },
                    {
                      "city": "Hobart",
                      "lat": -42.88,
                      "lon": 147.33,
                      "side": "EU",
                      "kx1": 0.12488,
                      "kx2": 0.01505,
                      "ky1": 0.01191,
                      "ky2": -0.0972,
                      "sy": -88.6
                    },
                    {
                      "city": "Darwin",
                      "lat": -12.46,
                      "lon": 130.84,
                      "side": "E",
                      "kx1": 0.09564,
                      "kx2": -0.00087,
                      "ky1": -0.00069,
                      "ky2": -0.09689,
                      "sy": 238.7
                    }
                  ]
                },
                "key": "city",
                "fields": [
                  "lat",
                  "lon",
                  "side",
                  "kx1",
                  "kx2",
                  "ky1",
                  "ky2",
                  "sy"
                ]
              }
            },
            {
              "calculate": "sqrt(datum.total / 800 * 2000) / 2 + 1.5",
              "as": "r"
            },
            {
              "calculate": "datum.city == 'Sydney' ? datum.r : null",
              "as": "syd_r0"
            },
            {
              "joinaggregate": [
                {
                  "op": "max",
                  "field": "syd_r0",
                  "as": "syd_r"
                }
              ]
            },
            {
              "calculate": "datum.side == 'E' || datum.side == 'EU' ? datum.r + 3 : datum.side == 'W' ? -datum.r - 3 : 16",
              "as": "px"
            },
            {
              "calculate": "datum.side == 'S' ? 28 : datum.side == 'EU' ? -16 : -6.5",
              "as": "py"
            },
            {
              "calculate": "datum.lon + datum.kx1 * datum.px + datum.kx2 * datum.py",
              "as": "llon"
            },
            {
              "calculate": "datum.lat + datum.ky1 * datum.px + datum.ky2 * datum.py",
              "as": "llat"
            },
            {
              "calculate": "[datum.city, format(datum.index, '.0f') + '%']",
              "as": "label"
            }
          ],
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          },
          "layer": [
            {
              "params": [
                {
                  "name": "pick",
                  "select": {
                    "type": "point",
                    "fields": [
                      "city"
                    ]
                  },
                  "value": [
                    {
                      "city": "Melbourne"
                    }
                  ]
                }
              ],
              "mark": {
                "type": "point",
                "opacity": 0.9,
                "cursor": "pointer",
                "filled": true,
                "shape": "circle"
              },
              "encoding": {
                "color": {
                  "field": "index",
                  "type": "quantitative",
                  "title": "Percentage of public transport trips (of 2018–2019 level)",
                  "scale": {
                    "type": "linear",
                    "domain": [
                      30,
                      90,
                      100,
                      110
                    ],
                    "range": [
                      "#E07B39",
                      "#EFB78F",
                      "#DDDAD0",
                      "#4A90D9"
                    ],
                    "interpolate": "lab",
                    "clamp": true
                  },
                  "legend": {
                    "title": [
                      "Percentage of public transport trips"
                    ],
                    "orient": "none",
                    "legendX": 41,
                    "legendY": 400,
                    "direction": "horizontal",
                    "gradientLength": 185,
                    "values": [
                      40,
                      60,
                      80,
                      100
                    ],
                    "labelExpr": "datum.value + '%'",
                    "type": "gradient",
                    "titleFontWeight": "normal",
                    "labelOverlap": false
                  }
                },
                "order": {
                  "field": "total",
                  "sort": "descending"
                },
                "stroke": {
                  "condition": {
                    "param": "pick",
                    "empty": false,
                    "value": "#222222"
                  },
                  "value": "#6B6B6B"
                },
                "strokeWidth": {
                  "condition": {
                    "param": "pick",
                    "empty": false,
                    "value": 3
                  },
                  "value": 1
                },
                "tooltip": [
                  {
                    "field": "city",
                    "title": "Capital"
                  },
                  {
                    "field": "fy",
                    "title": "Year"
                  },
                  {
                    "field": "total",
                    "format": ",.1f",
                    "title": "Trips (millions)"
                  },
                  {
                    "field": "pct_tip",
                    "title": "Percentage of public transport trips"
                  }
                ],
                "size": {
                  "field": "total",
                  "type": "quantitative",
                  "scale": {
                    "domain": [
                      0,
                      800
                    ],
                    "range": [
                      0,
                      2000
                    ]
                  },
                  "legend": {
                    "title": "Trips in the selected year (millions)",
                    "orient": "none",
                    "legendX": 245,
                    "legendY": 400,
                    "direction": "horizontal",
                    "values": [
                      10,
                      100,
                      500
                    ],
                    "symbolType": "circle",
                    "symbolFillColor": "#BBBBBB",
                    "symbolStrokeColor": "#777777",
                    "titleFontWeight": "normal"
                  }
                }
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.side == 'W'"
                }
              ],
              "mark": {
                "type": "text",
                "align": "right",
                "baseline": "middle",
                "fontSize": 11,
                "lineHeight": 13,
                "fontWeight": "bold",
                "color": "#222"
              },
              "encoding": {
                "longitude": {
                  "field": "llon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "llat",
                  "type": "quantitative"
                },
                "text": {
                  "field": "label"
                }
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.side == 'E' || datum.side == 'EU'"
                }
              ],
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "fontSize": 11,
                "lineHeight": 13,
                "fontWeight": "bold",
                "color": "#222"
              },
              "encoding": {
                "longitude": {
                  "field": "llon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "llat",
                  "type": "quantitative"
                },
                "text": {
                  "field": "label"
                }
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.side == 'S'"
                }
              ],
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "top",
                "fontSize": 11,
                "lineHeight": 13,
                "fontWeight": "bold",
                "color": "#222"
              },
              "encoding": {
                "longitude": {
                  "field": "llon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "llat",
                  "type": "quantitative"
                },
                "text": {
                  "field": "label"
                }
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.city == 'Canberra'"
                }
              ],
              "mark": {
                "type": "point",
                "shape": "M 14 26 L 5.6 10.4 M 2.8 5.3 L 2.6 12.0 L 8.6 8.8 Z",
                "size": 4,
                "filled": true,
                "color": "#555",
                "stroke": "#555",
                "strokeWidth": 1.2
              }
            }
          ]
        }
      ]
    },
    {
      "width": 306,
      "height": 360,
      "data": {
        "url": "data/bitre_city_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "train": "number",
            "light_rail": "number",
            "bus": "number",
            "ferry": "number",
            "year": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.train + datum.light_rail + datum.bus + datum.ferry",
          "as": "total"
        },
        {
          "calculate": "datum.year == 2019 ? datum.total : null",
          "as": "b"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "b",
              "as": "base"
            }
          ],
          "groupby": [
            "city"
          ]
        },
        {
          "calculate": "datum.total / datum.base * 100",
          "as": "index"
        },
        {
          "calculate": "format(datum.index, '.0f') + '%'",
          "as": "pct_tip"
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "index",
              "as": "low"
            }
          ],
          "groupby": [
            "city"
          ]
        },
        {
          "calculate": "datum.year == fy ? datum.index : null",
          "as": "cur0"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "cur0",
              "as": "cur"
            }
          ],
          "groupby": [
            "city"
          ]
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.year == 2022 && datum.city == 'Sydney'"
            },
            {
              "calculate": "2021.5",
              "as": "s"
            },
            {
              "calculate": "2022.5",
              "as": "e"
            }
          ],
          "mark": {
            "type": "rect",
            "color": "#EEEEEA"
          },
          "encoding": {
            "x": {
              "field": "s",
              "type": "quantitative",
              "scale": {
                "zero": false
              }
            },
            "x2": {
              "field": "e"
            },
            "y": {
              "value": 0
            },
            "y2": {
              "value": 360
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#999",
            "strokeDash": [
              3,
              3
            ]
          },
          "encoding": {
            "y": {
              "datum": 100
            }
          }
        },
        {
          "mark": {
            "type": "line",
            "strokeWidth": 1,
            "opacity": 1,
            "color": "#CCCCCC"
          },
          "encoding": {
            "y": {
              "field": "index",
              "type": "quantitative",
              "title": [
                "Percentage of Public Transport Trips",
                "(2018–2019 = 100%)"
              ],
              "scale": {
                "domain": [
                  40,
                  120
                ]
              },
              "axis": {
                "values": [
                  0,
                  20,
                  40,
                  60,
                  80,
                  100,
                  120
                ],
                "labelExpr": "datum.value + '%'"
              }
            },
            "detail": {
              "field": "city"
            },
            "x": {
              "field": "year",
              "type": "quantitative",
              "title": "Financial Year Ending June",
              "axis": {
                "format": "d",
                "tickCount": 5
              },
              "scale": {
                "domain": [
                  2016,
                  2025
                ]
              }
            }
          }
        },
        {
          "transform": [
            {
              "filter": {
                "param": "pick",
                "empty": false
              }
            }
          ],
          "mark": {
            "type": "line",
            "strokeWidth": 3.5,
            "point": {
              "filled": true,
              "size": 30,
              "color": "#555"
            }
          },
          "encoding": {
            "y": {
              "field": "index",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "city"
              },
              {
                "field": "fy",
                "title": "Year"
              },
              {
                "field": "pct_tip",
                "title": "Percentage of public transport trips"
              }
            ],
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "stroke": {
              "condition": {
                "test": "round(datum.cur) >= 100",
                "value": "#4A90D9"
              },
              "value": "#E07B39"
            }
          }
        },
        {
          "transform": [
            {
              "filter": {
                "param": "pick",
                "empty": false
              }
            },
            {
              "filter": "datum.year == 2025"
            },
            {
              "calculate": "datum.city + ' ' + format(datum.index, '.0f') + '%'",
              "as": "endlab"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 6,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#222"
          },
          "encoding": {
            "y": {
              "field": "index",
              "type": "quantitative"
            },
            "text": {
              "field": "endlab"
            },
            "x": {
              "field": "year",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year == fy && datum.city == 'Sydney'"
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#999",
            "strokeDash": [
              3,
              3
            ],
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year == 2022 && datum.city == 'Sydney'"
            }
          ],
          "mark": {
            "type": "text",
            "y": 352,
            "align": "center",
            "fontSize": 11,
            "color": "#666",
            "text": "Delta lockdowns"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": {
                "param": "pick",
                "empty": false
              }
            },
            {
              "filter": "datum.index == datum.low"
            },
            {
              "calculate": "'Low: ' + format(datum.index, '.0f') + '% (' + datum.fy + ')'",
              "as": "lowlab"
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "point",
                "filled": true,
                "size": 70,
                "color": "#222"
              },
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative"
                },
                "y": {
                  "field": "index",
                  "type": "quantitative"
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "center",
                "baseline": "top",
                "dy": 10,
                "fontSize": 12,
                "fontWeight": "bold",
                "color": "#222"
              },
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative"
                },
                "y": {
                  "field": "index",
                  "type": "quantitative"
                },
                "text": {
                  "field": "lowlab"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "spacing": 79,
  "padding": {
    "left": 5,
    "top": 5,
    "right": 2,
    "bottom": 5
  },
  "resolve": {
    "scale": {
      "stroke": "independent"
    },
    "legend": {
      "stroke": "independent"
    }
  }
}