{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/vic_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month": "date",
        "metro_train": "number",
        "tram": "number",
        "metro_bus": "number",
        "regional_train": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "metro_train",
        "tram",
        "metro_bus",
        "regional_train"
      ],
      "as": [
        "mode_key",
        "trips"
      ]
    },
    {
      "calculate": "{'metro_train':'Metro train','tram':'Tram †','metro_bus':'Metro bus','regional_train':'Regional train'}[datum.mode_key]",
      "as": "mode"
    },
    {
      "calculate": "datum.trips / 1000000",
      "as": "trips_m"
    },
    {
      "calculate": "year(datum.month) == 2019 ? datum.trips : null",
      "as": "b"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "b",
          "as": "base"
        }
      ],
      "groupby": [
        "mode"
      ]
    },
    {
      "calculate": "(datum.trips / datum.base - 1) * 100",
      "as": "dev"
    },
    {
      "calculate": "(datum.dev < 0 ? '−' : '+') + format(abs(datum.dev), '.0f') + '%'",
      "as": "dev_tip"
    },
    {
      "calculate": "max(0, min(30, -datum.dev))",
      "as": "n1"
    },
    {
      "calculate": "max(0, min(30, -datum.dev - 30))",
      "as": "n2"
    },
    {
      "calculate": "max(0, min(30, -datum.dev - 60))",
      "as": "n3"
    },
    {
      "calculate": "max(0, min(30, datum.dev))",
      "as": "p1"
    },
    {
      "calculate": "max(0, min(30, datum.dev - 30))",
      "as": "p2"
    },
    {
      "calculate": "max(0, min(30, datum.dev - 60))",
      "as": "p3"
    }
  ],
  "params": [
    {
      "name": "vicMode",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "Metro train",
          "Tram †",
          "Metro bus",
          "Regional train"
        ],
        "labels": [
          "All modes",
          "Metro train",
          "Tram",
          "Metro bus",
          "Regional train"
        ],
        "name": " ",
        "element": "#legend_3_3"
      }
    }
  ],
  "padding": {
    "left": 5,
    "top": 5,
    "right": 5,
    "bottom": 5
  },
  "facet": {
    "row": {
      "field": "mode",
      "type": "nominal",
      "title": null,
      "sort": [
        "Metro train",
        "Tram †",
        "Metro bus",
        "Regional train"
      ],
      "header": {
        "labels": false
      }
    }
  },
  "spacing": 6,
  "spec": {
    "width": 820,
    "height": 42,
    "encoding": {
      "x": {
        "field": "month",
        "type": "temporal",
        "title": "Year",
        "axis": {
          "format": "%Y",
          "tickCount": 9,
          "grid": false
        }
      }
    },
    "layer": [
      {
        "transform": [
          {
            "fold": [
              "n1",
              "n2",
              "n3",
              "p1",
              "p2",
              "p3"
            ],
            "as": [
              "band",
              "v"
            ]
          }
        ],
        "mark": {
          "type": "area",
          "interpolate": "monotone"
        },
        "encoding": {
          "y": {
            "field": "v",
            "type": "quantitative",
            "stack": null,
            "scale": {
              "domain": [
                0,
                30
              ]
            },
            "axis": null
          },
          "color": {
            "field": "band",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": [
                "n3",
                "n2",
                "n1",
                "p1",
                "p2",
                "p3"
              ],
              "range": [
                "#B3471A",
                "#E39058",
                "#F6D3B8",
                "#C6DBEF",
                "#6BAED6",
                "#2166AC"
              ]
            }
          },
          "opacity": {
            "condition": {
              "test": "vicMode == 'All' || datum.mode == vicMode",
              "value": 1
            },
            "value": 0.15
          }
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ],
            "groupby": [
              "mode"
            ]
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "middle",
          "fontSize": 12,
          "fontWeight": 600,
          "color": "#222"
        },
        "encoding": {
          "text": {
            "field": "mode"
          },
          "x": {
            "value": -10
          },
          "y": {
            "value": 21.0
          }
        }
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ],
            "groupby": [
              "mode"
            ]
          },
          {
            "filter": "datum.mode == 'Metro train'"
          },
          {
            "calculate": "toDate('2020-03-30')",
            "as": "s"
          },
          {
            "calculate": "toDate('2021-10-21')",
            "as": "e"
          }
        ],
        "layer": [
          {
            "mark": {
              "type": "rule",
              "color": "#888",
              "strokeWidth": 1.5,
              "y": -3
            },
            "encoding": {
              "x": {
                "field": "s",
                "type": "temporal"
              },
              "x2": {
                "field": "e"
              }
            }
          },
          {
            "mark": {
              "type": "text",
              "y": -6,
              "baseline": "bottom",
              "fontSize": 11,
              "color": "#666",
              "text": "Lockdowns"
            },
            "encoding": {
              "x": {
                "field": "s",
                "type": "temporal"
              }
            },
            "transform": [
              {
                "calculate": "toDate((+datum.s + +datum.e) / 2)",
                "as": "s"
              }
            ]
          }
        ]
      },
      {
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ],
            "groupby": [
              "mode"
            ]
          },
          {
            "filter": "datum.mode == 'Metro train'"
          },
          {
            "calculate": "toDate('2025-11-30')",
            "as": "s"
          },
          {
            "calculate": "toDate('2026-02-01')",
            "as": "e"
          }
        ],
        "layer": [
          {
            "mark": {
              "type": "rule",
              "color": "#888",
              "strokeWidth": 1.5,
              "y": -3
            },
            "encoding": {
              "x": {
                "field": "s",
                "type": "temporal"
              },
              "x2": {
                "field": "e"
              }
            }
          },
          {
            "mark": {
              "type": "text",
              "y": -6,
              "baseline": "bottom",
              "fontSize": 11,
              "color": "#666",
              "text": "Free weekends"
            },
            "encoding": {
              "x": {
                "field": "s",
                "type": "temporal"
              }
            },
            "transform": [
              {
                "calculate": "toDate((+datum.s + +datum.e) / 2)",
                "as": "s"
              }
            ]
          }
        ]
      },
      {
        "params": [
          {
            "name": "monthHover",
            "select": {
              "type": "point",
              "fields": [
                "month"
              ],
              "on": "mouseover",
              "nearest": true,
              "clear": "mouseout"
            }
          }
        ],
        "mark": {
          "type": "rule",
          "color": "#999",
          "strokeDash": [
            3,
            3
          ]
        },
        "encoding": {
          "opacity": {
            "condition": {
              "param": "monthHover",
              "value": 1,
              "empty": false
            },
            "value": 0
          },
          "tooltip": [
            {
              "field": "mode",
              "title": "Mode"
            },
            {
              "field": "month",
              "timeUnit": "yearmonth",
              "title": "Month",
              "format": "%B %Y"
            },
            {
              "field": "trips_m",
              "format": ".1f",
              "title": "Trips (millions)"
            },
            {
              "field": "dev_tip",
              "title": "Change from 2019 average (percentage)"
            }
          ]
        }
      }
    ]
  }
}
