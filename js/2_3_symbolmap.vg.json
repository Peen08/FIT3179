{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "params": [
    {
      "name": "year_pick",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [
          2019,
          2021,
          2022,
          2023,
          2025
        ],
        "name": "Year",
        "element": "#filter_2_3"
      }
    },
    {
      "name": "centre",
      "value": [
        150.975,
        -33.85
      ]
    },
    {
      "name": "zoom",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 6.5,
        "step": 0.01,
        "name": "Zoom ",
        "element": "#zoom_2_3"
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "centre"
    },
    "scale": {
      "expr": "zoom * 34000"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/syd_land.topojson",
        "format": {
          "type": "topojson",
          "feature": "syd_land"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1F1EC",
        "stroke": "#DDDDDD"
      }
    },
    {
      "data": {
        "url": "data/syd_stations.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "y2019": "number",
            "y2021": "number",
            "y2022": "number",
            "y2023": "number",
            "y2025": "number"
          }
        }
      },
      "transform": [
        {
          "fold": [
            "y2019",
            "y2021",
            "y2022",
            "y2023",
            "y2025"
          ],
          "as": [
            "year_key",
            "trips"
          ]
        },
        {
          "calculate": "toNumber(substring(datum.year_key, 1))",
          "as": "year"
        },
        {
          "filter": "datum.year == year_pick && datum.trips > 0"
        },
        {
          "calculate": "floor(datum.lon / 0.025) * 0.025",
          "as": "x0"
        },
        {
          "calculate": "floor(datum.lat / 0.0207) * 0.0207",
          "as": "y0"
        },
        {
          "calculate": "datum.type == 'Sydney Trains' ? 0 : 1",
          "as": "is_metro"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "trips",
              "as": "trips"
            },
            {
              "op": "count",
              "as": "stations"
            },
            {
              "op": "max",
              "field": "is_metro",
              "as": "has_metro"
            },
            {
              "op": "argmax",
              "field": "trips",
              "as": "top"
            }
          ],
          "groupby": [
            "x0",
            "y0",
            "year"
          ]
        },
        {
          "calculate": "datum.top.station",
          "as": "busiest"
        },
        {
          "calculate": "datum.trips / 1000000",
          "as": "trips_m"
        },
        {
          "calculate": "{type: 'Feature', geometry: {type: 'Polygon', coordinates: [[[datum.x0, datum.y0], [datum.x0, datum.y0 + 0.0207], [datum.x0 + 0.025, datum.y0 + 0.0207], [datum.x0 + 0.025, datum.y0], [datum.x0, datum.y0]]]}}",
          "as": "square"
        }
      ],
      "mark": {
        "type": "geoshape",
        "strokeJoin": "miter"
      },
      "encoding": {
        "shape": {
          "field": "square",
          "type": "geojson"
        },
        "color": {
          "field": "trips_m",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              2,
              5,
              10,
              25,
              50
            ],
            "range": [
              "#F2F0C9",
              "#DCE49A",
              "#B5CF66",
              "#82B03D",
              "#4F8A22",
              "#2C5E12"
            ]
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "test": "datum.has_metro == 1",
            "value": "#222222"
          },
          "value": "#FFFFFF"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.has_metro == 1",
            "value": 2
          },
          "value": 0.5
        },
        "order": {
          "field": "has_metro"
        },
        "tooltip": [
          {
            "field": "trips",
            "format": ",",
            "title": "Trips in this square"
          },
          {
            "field": "stations",
            "title": "Number of stations"
          },
          {
            "field": "busiest",
            "title": "Busiest station"
          },
          {
            "field": "year",
            "title": "Year"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/syd_lines.topojson",
        "format": {
          "type": "topojson",
          "feature": "syd_lines"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#9A9A9A",
        "strokeWidth": 0.8,
        "opacity": 0.7
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "City centre",
            "lon": 151.255,
            "lat": -33.861,
            "x1": 151.225,
            "y1": -33.8652,
            "x2": 151.253,
            "y2": -33.861,
            "align": "left"
          },
          {
            "label": "Chatswood",
            "lon": 151.214,
            "lat": -33.776,
            "align": "left",
            "x1": 151.1925,
            "y1": -33.7824,
            "x2": 151.212,
            "y2": -33.777
          },
          {
            "label": [
              "North Sydney–",
              "Crows Nest"
            ],
            "lon": 151.2305,
            "lat": -33.8175,
            "x1": 151.2205,
            "y1": -33.8285,
            "x2": 151.229,
            "y2": -33.8195,
            "align": "left",
            "base": "bottom",
            "small": true
          }
        ]
      },
      "layer": [
        {
          "transform": [
            {
              "filter": "isValid(datum.x1)"
            }
          ],
          "mark": {
            "type": "rule",
            "stroke": "#555555",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "x1",
              "type": "quantitative"
            },
            "latitude": {
              "field": "y1",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "x2"
            },
            "latitude2": {
              "field": "y2"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "baseline": {
              "expr": "datum.base ? datum.base : 'middle'"
            },
            "fontSize": {
              "expr": "datum.small ? 10 : 11"
            },
            "fontWeight": "bold",
            "align": {
              "expr": "datum.align"
            },
            "lineHeight": 12
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ]
}