{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 582,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/bitre_city_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "train": "number",
        "light_rail": "number",
        "bus": "number",
        "ferry": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.train + datum.light_rail + datum.bus + datum.ferry",
      "as": "total"
    },
    {
      "filter": "datum.year == 2019 || datum.year == 2025"
    },
    {
      "calculate": "datum.year == 2019 ? datum.total : null",
      "as": "b"
    },
    {
      "calculate": "datum.year == 2025 ? datum.total : null",
      "as": "l"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "b",
          "as": "before"
        },
        {
          "op": "max",
          "field": "l",
          "as": "after"
        }
      ],
      "groupby": [
        "city"
      ]
    },
    {
      "calculate": "datum.after >= datum.before ? 'More trips' : 'Fewer trips'",
      "as": "trend"
    },
    {
      "calculate": "datum.year == 2019 ? '2018–2019' : '2024–2025'",
      "as": "period"
    },
    {
      "calculate": "(datum.after / datum.before - 1) * 100",
      "as": "chg"
    },
    {
      "calculate": "format(datum.chg, '+.0f') + '%'",
      "as": "chg_tip"
    },
    {
      "calculate": "(datum.city == 'Melbourne' || datum.city == 'Perth') ? datum.city + '  ' + format(datum.total, ',.0f') : datum.city == 'Hobart' ? 'Hobart, Darwin' : datum.city == 'Darwin' ? '' : datum.city",
      "as": "rlab"
    },
    {
      "lookup": "city",
      "from": {
        "data": {
          "values": [
            {
              "city": "Sydney",
              "ly": 709
            },
            {
              "city": "Melbourne",
              "ly": 480
            },
            {
              "city": "Brisbane",
              "ly": 172
            },
            {
              "city": "Perth",
              "ly": 139
            },
            {
              "city": "Adelaide",
              "ly": 72
            },
            {
              "city": "Canberra",
              "ly": 21
            },
            {
              "city": "Hobart",
              "ly": 5
            },
            {
              "city": "Darwin",
              "ly": 5
            }
          ]
        },
        "key": "city",
        "fields": [
          "ly"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "title": "Financial Year",
      "axis": {
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "titlePadding": 10
      },
      "scale": {
        "padding": 1.1
      }
    },
    "y": {
      "field": "total",
      "type": "quantitative",
      "title": "Trips per Year (Millions)",
      "scale": {
        "domain": [
          0,
          800
        ]
      },
      "axis": {
        "grid": true,
        "values": [
          0,
          100,
          200,
          300,
          400,
          500,
          600,
          700,
          800
        ],
        "gridColor": "#E5E5E0"
      }
    },
    "color": {
      "field": "trend",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "More trips",
          "Fewer trips"
        ],
        "range": [
          "#2166AC",
          "#C2571A"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "city"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "opacity": {
          "condition": {
            "test": "trendSel == 'All' || datum.trend == trendSel",
            "value": 1
          },
          "value": 0.12
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 50,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "city"
          },
          {
            "field": "period"
          },
          {
            "field": "total",
            "format": ",.1f",
            "title": "Trips (millions)"
          },
          {
            "field": "chg_tip",
            "title": "Change (percentage)"
          }
        ],
        "opacity": {
          "condition": {
            "test": "trendSel == 'All' || datum.trend == trendSel",
            "value": 1
          },
          "value": 0.12
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 0,
        "fontSize": 11,
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "rlab"
        },
        "opacity": {
          "condition": {
            "test": "trendSel == 'All' || datum.trend == trendSel",
            "value": 1
          },
          "value": 0.12
        },
        "y": {
          "field": "ly",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2019 && (datum.city == 'Melbourne' || datum.city == 'Perth')"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 11,
        "color": "#555"
      },
      "encoding": {
        "text": {
          "field": "total",
          "format": ",.0f"
        },
        "opacity": {
          "condition": {
            "test": "trendSel == 'All' || datum.trend == trendSel",
            "value": 1
          },
          "value": 0.12
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025 && datum.city == 'Melbourne'"
        }
      ],
      "encoding": {
        "opacity": {
          "condition": {
            "test": "trendSel == 'All' || datum.trend == trendSel",
            "value": 1
          },
          "value": 0.12
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "fill": "#FBEDE4",
            "stroke": "#F0C9AE",
            "strokeWidth": 1,
            "cornerRadius": 2,
            "xOffset": -215,
            "x2Offset": -25,
            "yOffset": 62,
            "y2Offset": 100
          },
          "encoding": {
            "x2": {
              "field": "period"
            },
            "y2": {
              "field": "total"
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "stroke": "#8A3A0F",
            "strokeWidth": 1.3,
            "xOffset": -80,
            "yOffset": 62,
            "x2Offset": -10.0,
            "y2Offset": 8.1
          },
          "encoding": {
            "x2": {
              "field": "period"
            },
            "y2": {
              "field": "total"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "shape": "triangle-up",
            "filled": true,
            "size": 45,
            "angle": 52.4,
            "color": "#8A3A0F",
            "xOffset": -8.4,
            "yOffset": 6.8
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "fontSize": 11,
            "lineHeight": 14,
            "text": [
              "Steepest fall: Melbourne",
              "106 million fewer trips (−18%)"
            ],
            "color": "#8A3A0F",
            "xOffset": -120.0,
            "yOffset": 81.0,
            "dy": -7
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2019 && datum.city == 'Perth'"
        }
      ],
      "encoding": {
        "opacity": {
          "condition": {
            "test": "trendSel == 'All' || datum.trend == trendSel",
            "value": 1
          },
          "value": 0.12
        }
      },
      "layer": [
        {
          "mark": {
            "type": "rect",
            "fill": "#E7EFF8",
            "stroke": "#B7CDE6",
            "strokeWidth": 1,
            "cornerRadius": 2,
            "xOffset": -124,
            "x2Offset": -16,
            "yOffset": 12,
            "y2Offset": 64
          },
          "encoding": {
            "x2": {
              "field": "period"
            },
            "y2": {
              "field": "total"
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "stroke": "#174A7C",
            "strokeWidth": 1.3,
            "xOffset": -16,
            "yOffset": 30,
            "x2Offset": -1.8,
            "y2Offset": 9.1
          },
          "encoding": {
            "x2": {
              "field": "period"
            },
            "y2": {
              "field": "total"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "shape": "triangle-up",
            "filled": true,
            "size": 45,
            "angle": 34.2,
            "color": "#174A7C",
            "xOffset": -0.7,
            "yOffset": 7.5
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "fontSize": 11,
            "lineHeight": 14,
            "text": [
              "Biggest rise: Perth",
              "7 million more",
              "trips (+5%)"
            ],
            "color": "#174A7C",
            "xOffset": -70.0,
            "yOffset": 38.0,
            "dy": -14
          }
        }
      ]
    }
  ],
  "params": [
    {
      "name": "trendSel",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "More trips",
          "Fewer trips"
        ],
        "labels": [
          "All cities",
          "More trips",
          "Fewer trips"
        ],
        "name": " ",
        "element": "#legend_1_3"
      }
    }
  ]
}