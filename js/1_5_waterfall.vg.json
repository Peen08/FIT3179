{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "params": [
    {
      "name": "wfMode",
      "value": "All modes",
      "bind": {
        "input": "select",
        "options": [
          "All modes",
          "Train",
          "Bus",
          "Tram / light rail",
          "Ferry"
        ],
        "name": "Mode",
        "element": "#filter_1_5"
      }
    }
  ],
  "width": "container",
  "height": 530,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/bitre_city_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "train": "number",
        "light_rail": "number",
        "bus": "number",
        "ferry": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.fy == '2018–2019' || datum.fy == '2024–2025'"
    },
    {
      "calculate": "wfMode == 'All modes' ? (datum.train || 0) + (datum.light_rail || 0) + (datum.bus || 0) + (datum.ferry || 0) : ({'Train': datum.train, 'Bus': datum.bus, 'Tram / light rail': datum.light_rail, 'Ferry': datum.ferry}[wfMode] || 0)",
      "as": "trips"
    },
    {
      "calculate": "indexof(['Hobart', 'Darwin', 'Canberra'], datum.city) >= 0 ? 'Hobart, Darwin, Canberra' : datum.city",
      "as": "step"
    },
    {
      "calculate": "datum.fy == '2018–2019' ? datum.trips : 0",
      "as": "before_part"
    },
    {
      "calculate": "datum.fy == '2024–2025' ? datum.trips : 0",
      "as": "after_part"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "before_part",
          "as": "before"
        },
        {
          "op": "sum",
          "field": "after_part",
          "as": "after"
        }
      ],
      "groupby": [
        "step"
      ]
    },
    {
      "calculate": "datum.after - datum.before",
      "as": "delta"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "before",
          "as": "total_before"
        },
        {
          "op": "sum",
          "field": "after",
          "as": "total_after"
        }
      ]
    },
    {
      "calculate": "indexof(['Melbourne', 'Sydney', 'Adelaide', 'Hobart, Darwin, Canberra', 'Brisbane', 'Perth'], datum.step)",
      "as": "ord"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "delta",
          "as": "cum"
        }
      ],
      "sort": [
        {
          "field": "ord"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.total_before + datum.cum - datum.delta",
      "as": "start"
    },
    {
      "calculate": "datum.total_before + datum.cum",
      "as": "end"
    },
    {
      "calculate": "datum.delta / (datum.total_after - datum.total_before)",
      "as": "share"
    },
    {
      "calculate": "datum.before == 0 && datum.after == 0 ? 'None' : (datum.delta < 0 ? 'Fewer trips' : 'More trips')",
      "as": "dir"
    },
    {
      "calculate": "datum.before == 0 && datum.after == 0 ? 'No service' : (datum.delta < 0 ? '−' : '+') + (abs(datum.delta) < 10 ? format(abs(datum.delta), '.1f') : format(abs(datum.delta), ',.0f')) + 'm'",
      "as": "delta_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "step",
      "type": "ordinal",
      "title": "Capital City",
      "scale": {
        "domain": [
          "2018–2019",
          "Melbourne",
          "Sydney",
          "Adelaide",
          "Hobart, Darwin, Canberra",
          "Brisbane",
          "Perth",
          "2024–2025"
        ],
        "paddingInner": 0.3
      },
      "axis": {
        "labelAngle": 0,
        "ticks": false,
        "labelFontSize": 11,
        "labelLineHeight": 13,
        "labelExpr": "datum.value == 'Hobart, Darwin, Canberra' ? ['Hobart,', 'Darwin,', 'Canberra'] : (datum.value == '2018–2019' || datum.value == '2024–2025' ? [datum.value, 'total'] : datum.value)",
        "titlePadding": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "y": {
          "field": "start",
          "type": "quantitative",
          "title": "Trips per Year (Millions)",
          "scale": {
            "domain": {
              "expr": "{'All modes': [0, 1800], 'Train': [0, 900], 'Bus': [0, 800], 'Tram / light rail': [0, 250], 'Ferry': [0, 30]}[wfMode]"
            }
          },
          "axis": {
            "values": {
              "expr": "{'All modes': sequence(0, 1801, 500), 'Train': sequence(0, 901, 150), 'Bus': sequence(0, 801, 200), 'Tram / light rail': sequence(0, 251, 50), 'Ferry': sequence(0, 31, 5)}[wfMode]"
            },
            "labelExpr": "format(datum.value, ',')"
          }
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "field": "dir",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Fewer trips",
              "More trips",
              "None"
            ],
            "range": [
              "#C2571A",
              "#2166AC",
              "#888888"
            ]
          }
        },
        "tooltip": [
          {
            "field": "step",
            "title": "City"
          },
          {
            "field": "before",
            "format": ",.1f",
            "title": "Trips 2018–2019 (millions)"
          },
          {
            "field": "after",
            "format": ",.1f",
            "title": "Trips 2024–2025 (millions)"
          },
          {
            "field": "delta_label",
            "title": "Change"
          },
          {
            "field": "share",
            "format": ".0%",
            "title": "Percentage of the national change"
          }
        ]
      }
    },
    {
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.delta < 0"
            }
          ],
          "mark": {
            "type": "text",
            "baseline": "top",
            "dy": 4,
            "fontSize": 11,
            "fontWeight": "bold"
          },
          "encoding": {
            "y": {
              "field": "end",
              "type": "quantitative"
            },
            "text": {
              "field": "delta_label"
            },
            "color": {
              "field": "dir",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Fewer trips",
                  "More trips",
                  "None"
                ],
                "range": [
                  "#C2571A",
                  "#2166AC",
                  "#888888"
                ]
              }
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.delta >= 0"
            }
          ],
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -4,
            "fontSize": 11,
            "fontWeight": "bold"
          },
          "encoding": {
            "y": {
              "field": "end",
              "type": "quantitative"
            },
            "text": {
              "field": "delta_label"
            },
            "color": {
              "field": "dir",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Fewer trips",
                  "More trips",
                  "None"
                ],
                "range": [
                  "#C2571A",
                  "#2166AC",
                  "#888888"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rn"
            }
          ]
        },
        {
          "filter": "datum.rn == 1"
        },
        {
          "fold": [
            "total_before",
            "total_after"
          ],
          "as": [
            "which",
            "value"
          ]
        },
        {
          "calculate": "datum.which == 'total_before' ? '2018–2019' : '2024–2025'",
          "as": "step"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#888888"
          },
          "encoding": {
            "y": {
              "field": "value",
              "type": "quantitative"
            },
            "y2": {
              "datum": 0
            },
            "tooltip": [
              {
                "field": "step",
                "title": "Financial year"
              },
              {
                "field": "value",
                "format": ",.0f",
                "title": "Trips (millions)"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "baseline": "bottom",
            "dy": -4,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#333"
          },
          "encoding": {
            "y": {
              "field": "value",
              "type": "quantitative"
            },
            "text": {
              "field": "value",
              "type": "quantitative",
              "format": ",.0f"
            }
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "!(datum.before == 0 && datum.after == 0)"
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "delta",
              "as": "dmin"
            },
            {
              "op": "max",
              "field": "delta",
              "as": "dmax"
            }
          ]
        },
        {
          "calculate": "datum.total_after - datum.total_before",
          "as": "net"
        },
        {
          "filter": "datum.delta == (datum.net < 0 ? datum.dmin : datum.dmax)"
        },
        {
          "calculate": "datum.delta / datum.net",
          "as": "nshare"
        },
        {
          "calculate": "datum.nshare > 0 && datum.nshare <= 1 ? [datum.step + ' alone:', format(datum.nshare, '.0%') + ' of the ' + (datum.net < 0 ? 'drop' : 'rise')] : ['Biggest change:', datum.step + ' ' + datum.delta_label]",
          "as": "note"
        },
        {
          "calculate": "datum.end - {'All modes': 1800, 'Train': 900, 'Bus': 800, 'Tram / light rail': 250, 'Ferry': 30}[wfMode] * 0.17",
          "as": "note_y"
        },
        {
          "calculate": "datum.end - {'All modes': 1800, 'Train': 900, 'Bus': 800, 'Tram / light rail': 250, 'Ferry': 30}[wfMode] * 0.13",
          "as": "line_bottom"
        },
        {
          "calculate": "datum.end - {'All modes': 1800, 'Train': 900, 'Bus': 800, 'Tram / light rail': 250, 'Ferry': 30}[wfMode] * 0.045",
          "as": "line_top"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#888",
            "strokeWidth": 1
          },
          "encoding": {
            "y": {
              "field": "line_top",
              "type": "quantitative"
            },
            "y2": {
              "field": "line_bottom"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#333",
            "lineHeight": 15,
            "dx": -4
          },
          "encoding": {
            "y": {
              "field": "note_y",
              "type": "quantitative"
            },
            "text": {
              "field": "note"
            }
          }
        }
      ]
    },
    {
      "layer": [
        {
          "mark": {
            "type": "rect",
            "color": "#F3F3EE",
            "stroke": "#E2E2DA",
            "cornerRadius": 4,
            "yOffset": -208,
            "y2Offset": -12,
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "x2": {
              "datum": "Perth",
              "type": "ordinal",
              "band": 1
            },
            "y": {
              "datum": 0
            },
            "y2": {
              "datum": 0
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 14,
            "dy": -196,
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#222",
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "value": "How to read this chart"
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#222",
            "strokeWidth": 1,
            "xOffset": 14,
            "x2Offset": 150,
            "yOffset": -178,
            "y2Offset": -178,
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "x2": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y2": {
              "datum": 0
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 14,
            "dy": -168,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#555",
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "value": "Grey bar"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 74,
            "dy": -168,
            "fontSize": 12,
            "fontWeight": "normal",
            "color": "#444",
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "value": "total trips in a year"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 14,
            "dy": -150,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#C2571A",
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "value": "Orange step"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 94,
            "dy": -150,
            "fontSize": 12,
            "fontWeight": "normal",
            "color": "#444",
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "value": "a city that lost trips"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 14,
            "dy": -132,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#2166AC",
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "value": "Blue step"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 80,
            "dy": -132,
            "fontSize": 12,
            "fontWeight": "normal",
            "color": "#444",
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "value": "a city that gained trips"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 14,
            "dy": -104,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#222",
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "value": "Key point:"
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#222",
            "strokeWidth": 1,
            "xOffset": 14,
            "x2Offset": 78,
            "yOffset": -87,
            "y2Offset": -87,
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "x2": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y2": {
              "datum": 0
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 14,
            "dy": -80,
            "fontSize": 12,
            "fontWeight": "normal",
            "color": "#444",
            "lineHeight": 19,
            "opacity": {
              "expr": "width >= 350 ? 1 : 0"
            }
          },
          "encoding": {
            "x": {
              "datum": "Melbourne",
              "type": "ordinal",
              "band": 0
            },
            "y": {
              "datum": 0
            },
            "text": {
              "field": "key_lines"
            }
          }
        }
      ],
      "transform": [
        {
          "aggregate": [
            {
              "op": "argmin",
              "field": "delta",
              "as": "amin"
            },
            {
              "op": "argmax",
              "field": "delta",
              "as": "amax"
            },
            {
              "op": "max",
              "field": "total_before",
              "as": "tb"
            },
            {
              "op": "max",
              "field": "total_after",
              "as": "ta"
            }
          ]
        },
        {
          "calculate": "(abs(datum.tb) < 10 ? format(abs(datum.tb), '.1f') : format(abs(datum.tb), ',.0f')) + ' million trips in 2018–2019'",
          "as": "start_txt"
        },
        {
          "calculate": "(abs(datum.ta) < 10 ? format(abs(datum.ta), '.1f') : format(abs(datum.ta), ',.0f')) + ' million in 2024–2025 (' + format(datum.ta / datum.tb, '.0%') + ')'",
          "as": "end_txt"
        },
        {
          "calculate": "'Net change: ' + (datum.ta < datum.tb ? '−' : '+') + (abs(datum.ta - datum.tb) < 10 ? format(abs(datum.ta - datum.tb), '.1f') : format(abs(datum.ta - datum.tb), ',.0f')) + ' million (' + (datum.ta < datum.tb ? '−' : '+') + format(abs(datum.ta / datum.tb - 1), '.0%') + ')'",
          "as": "k1"
        },
        {
          "calculate": "datum.amin.delta < 0 ? 'Biggest fall: ' + datum.amin.step + ' (−' + (abs(datum.amin.delta) < 10 ? format(abs(datum.amin.delta), '.1f') : format(abs(datum.amin.delta), ',.0f')) + ' million)' : 'Biggest fall: none'",
          "as": "k2"
        },
        {
          "calculate": "datum.amax.delta > 0 ? 'Biggest rise: ' + datum.amax.step + ' (+' + (abs(datum.amax.delta) < 10 ? format(abs(datum.amax.delta), '.1f') : format(abs(datum.amax.delta), ',.0f')) + ' million)' : 'Biggest rise: none'",
          "as": "k3"
        },
        {
          "calculate": "[datum.k1, datum.k2, datum.k3]",
          "as": "key_lines"
        }
      ]
    }
  ]
}
